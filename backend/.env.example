MONGODB_URI=mongodb://127.0.0.1:27017/proofpass
JWT_SECRET=replace-with-a-long-random-secret
AuthenticationService_PORT=5000

# --- Frontend CORS ---
FRONTEND_URL=http://localhost:5173

# --- Chain ---
# Chipnet Electrum/Fulcrum endpoint used by the CashScript provider.
CHIPNET_ELECTRUM_URL=wss://chipnet.imaginary.cash:50004
CHIPNET_NETWORK=chipnet

# Chipnet block explorer API for payment verification.
CHIPNET_INDEXER_URL=https://replace-with-chipnet-indexer

# --- Contract deployment info (one block per license type) ---
# Filled in after `node scripts/deploy.js <type>` runs against real chipnet.
# <PREFIX>_ISSUER_CATEGORY_ID is the genesis category ID.
PRC_ISSUER_CATEGORY_ID=
PRC_ISSUER_TOKEN_ADDRESS=
PRC_LICENSE_VAULT_ADDRESS=
PRC_LICENSE_VAULT_TOKEN_ADDRESS=
PRC_RENEWAL_FEE_SATS=1000
PRC_ISSUANCE_FEE_SATS=5000
PRC_TERM_LENGTH_BLOCKS=4320

BUSINESS_ISSUER_CATEGORY_ID=
BUSINESS_ISSUER_TOKEN_ADDRESS=
BUSINESS_LICENSE_VAULT_ADDRESS=
BUSINESS_LICENSE_VAULT_TOKEN_ADDRESS=
BUSINESS_RENEWAL_FEE_SATS=1000
BUSINESS_ISSUANCE_FEE_SATS=5000
BUSINESS_TERM_LENGTH_BLOCKS=4320

DRIVER_ISSUER_CATEGORY_ID=
DRIVER_ISSUER_TOKEN_ADDRESS=
DRIVER_LICENSE_VAULT_ADDRESS=
DRIVER_LICENSE_VAULT_TOKEN_ADDRESS=
DRIVER_RENEWAL_FEE_SATS=1000
DRIVER_ISSUANCE_FEE_SATS=5000
DRIVER_TERM_LENGTH_BLOCKS=4320

# --- Global LicenseVault constructor args (shared across all types) ---
# Public, not secrets. Needed to re-instantiate the contract.
ADMIN_PUBLIC_KEY_HEX=
TREASURY_PUBLIC_KEY_HEX=
TREASURY_LOCKING_BYTECODE=
TREASURY_CHIPNET_ADDRESS=

# --- Relayer key (the ONE server-held key) ---
# Funds the BCH input that covers the renewal fee + miner fee. NOT the admin
# key. Scoped to "can pay small chipnet fees," nothing else. The covenant checks
# no signature for renew(), so this key authorizes nothing on-chain.
RELAYER_PRIVATE_KEY_HEX=

# --- Auth (dapp model — no passwords) ---
# Comma-separated wallet addresses recognized as admin.
ADMIN_ADDRESSES=
# Random secret used to sign session cookies/JWTs issued AFTER a wallet
# signature is verified. Not a blockchain key.
SESSION_SECRET=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:5000
VITE_PRC_CATEGORY_ID=
VITE_BUSINESS_CATEGORY_ID=
VITE_DRIVER_CATEGORY_ID=
VITE_TREASURY_CHIPNET_ADDRESS=
VITE_RENEWAL_FEE_SATS=1000
VITE_ISSUANCE_FEE_SATS=5000