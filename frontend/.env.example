# API base the frontend calls. In dev, set to the backend's Express port.
VITE_API_URL=http://localhost:5000

# WalletConnect project ID — required for wallet connection (Paytaca).
# Get one from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# One VITE_<TYPE>_CATEGORY_ID per license type deployed.
# Same values as each type's <PREFIX>_ISSUER_CATEGORY_ID in backend/.env.
VITE_PRC_CATEGORY_ID=
VITE_BUSINESS_CATEGORY_ID=
VITE_DRIVER_CATEGORY_ID=

# Shown to users as the payment destination + informational fee amounts.
# Same values as TREASURY_CHIPNET_ADDRESS / *_RENEWAL_FEE_SATS / *_ISSUANCE_FEE_SATS
# in backend/.env.
VITE_TREASURY_CHIPNET_ADDRESS=
VITE_RENEWAL_FEE_SATS=1000
VITE_ISSUANCE_FEE_SATS=5000