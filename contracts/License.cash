pragma cashscript ^0.13.0;

/**
 * A CashToken-backed, non-transferable license covenant.
 *
 * There are two UTXO roles at this one covenant address:
 * 1. An authority NFT (minting capability, commitment 0xa1). It can mint the
 *    next immutable license NFT, but is never shown as a license.
 * 2. An active license NFT (immutable capability, 31-byte commitment). It
 *    identifies the holder and expiry and can only remain in this covenant.
 *
 * Fixed input and output positions make this educational contract easy to
 * audit. The JavaScript transaction builders deliberately use those positions.
 */
contract License(pubkey issuerPk, bytes32 tokenCategory, bytes1 authorityCommitment, int renewalFee) {
    /**
     * Issuer-only issuance.
     *
     * Input 0: authority NFT at this covenant.
     * Output 0: replacement authority NFT at this covenant.
     * Output 1: new immutable license NFT at this covenant.
     *
     * The output bytecode equality is the soulbound rule: an issued NFT cannot
     * be directed to a recipient wallet, only to this same covenant.
     */
    function issue(bytes31 newLicenseCommitment, sig issuerSignature) {
        require(checkSig(issuerSignature, issuerPk));
        require(tx.inputs.length == 1);
        require(tx.outputs.length == 2);
        require(tx.inputs[0].lockingBytecode == tx.outputs[0].lockingBytecode);
        require(tx.inputs[0].lockingBytecode == tx.outputs[1].lockingBytecode);
        require(tx.outputs[0].value >= 1000);
        require(tx.outputs[1].value >= 1000);

        // Authority: CashTokens appends 0x02 for a minting-capability NFT.
        require(tx.inputs[0].tokenCategory == tokenCategory + 0x02);
        require(tx.inputs[0].nftCommitment == authorityCommitment);
        // Every active commitment begins with format=1 and state=1.
        require(newLicenseCommitment.slice(0, 2) == 0x0101);

        // Preserve the minting NFT so future licenses can be issued.
        require(tx.outputs[0].tokenCategory == tokenCategory + 0x02);
        require(tx.outputs[0].nftCommitment == authorityCommitment);

        // Mint exactly one immutable NFT whose commitment is the license record.
        require(tx.outputs[1].tokenCategory == tokenCategory);
        require(tx.outputs[1].nftCommitment == newLicenseCommitment);
    }

    /**
     * Holder-only renewal.
     *
     * Input 0: old immutable license NFT. Input 1: minting authority NFT.
     * Output 0: replacement immutable license NFT. Output 1: authority NFT.
     * Output 2: renewal fee paid to the issuer's standard P2PKH address.
     */
    function renew(
        bytes31 previousLicenseCommitment,
        bytes31 renewedLicenseCommitment,
        pubkey holderPk,
        sig holderSignature
    ) {
        require(tx.inputs.length == 2);
        require(tx.outputs.length == 3);
        require(tx.inputs[0].lockingBytecode == tx.inputs[1].lockingBytecode);
        require(tx.inputs[0].lockingBytecode == tx.outputs[0].lockingBytecode);
        require(tx.inputs[0].lockingBytecode == tx.outputs[1].lockingBytecode);
        require(tx.outputs[0].value >= 1000);
        require(tx.outputs[1].value >= 1000);

        // The holder hash is inside bytes 2..21 of the old on-chain commitment.
        // Matching it before checkSig prevents someone else from renewing.
        require(hash160(holderPk) == previousLicenseCommitment.slice(2, 22));
        require(checkSig(holderSignature, holderPk));

        require(previousLicenseCommitment.slice(0, 2) == 0x0101);
        require(renewedLicenseCommitment.slice(0, 2) == 0x0101);
        require(tx.inputs[1].tokenCategory == tokenCategory + 0x02);
        require(tx.inputs[1].nftCommitment == authorityCommitment);

        // The actual license input must be the exact commitment presented here.
        require(tx.inputs[0].tokenCategory == tokenCategory);
        require(tx.inputs[0].nftCommitment == previousLicenseCommitment);

        // Renewal may change only the 4-byte expiry (bytes 22..25).
        require(previousLicenseCommitment.slice(0, 22) == renewedLicenseCommitment.slice(0, 22));
        require(previousLicenseCommitment.slice(26, 31) == renewedLicenseCommitment.slice(26, 31));
        int oldExpiry = int(previousLicenseCommitment.slice(22, 26));
        int newExpiry = int(renewedLicenseCommitment.slice(22, 26));
        require(newExpiry > oldExpiry);

        // Replace, rather than transfer, the immutable NFT at the same covenant.
        require(tx.outputs[0].tokenCategory == tokenCategory);
        require(tx.outputs[0].nftCommitment == renewedLicenseCommitment);
        require(tx.outputs[1].tokenCategory == tokenCategory + 0x02);
        require(tx.outputs[1].nftCommitment == authorityCommitment);

        // Fees are an explicit contract rule, not a frontend convention.
        bytes25 issuerP2pkh = 0x76a914 + hash160(issuerPk) + 0x88ac;
        require(tx.outputs[2].lockingBytecode == issuerP2pkh);
        require(tx.outputs[2].value >= renewalFee);
    }

    /**
     * Issuer-only revocation.
     *
     * The active NFT is intentionally not recreated. It is burned, leaving no
     * contract UTXO that a holder can renew or transfer in the future.
     */
    function revoke(bytes31 revokedLicenseCommitment, sig issuerSignature) {
        require(checkSig(issuerSignature, issuerPk));
        require(tx.inputs.length == 1);
        require(tx.outputs.length == 1);
        require(revokedLicenseCommitment.slice(0, 2) == 0x0101);
        require(tx.inputs[0].tokenCategory == tokenCategory);
        require(tx.inputs[0].nftCommitment == revokedLicenseCommitment);

        // No token output is allowed: the NFT is permanently burned.
        require(tx.outputs[0].tokenCategory == 0x);
        require(tx.outputs[0].nftCommitment == 0x);
        bytes25 issuerP2pkh = 0x76a914 + hash160(issuerPk) + 0x88ac;
        require(tx.outputs[0].lockingBytecode == issuerP2pkh);
        require(tx.outputs[0].value >= 546);
    }
}
